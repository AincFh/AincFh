{
  "id": "./",
  "name": "AincFh OS — Interactive Web Desktop",
  "short_name": "AincFh OS",
  "description": "An interactive browser desktop with projects, files, notes, Paint, Task Manager and Control Center. Data is stored locally.",
  "lang": "en",
  "dir": "auto",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "background_color": "#10121c",
  "theme_color": "#ff9f43",
  "orientation": "any",
  "categories": [
    "productivity",
    "utilities",
    "personalization"
  ],
  "icons": [
    {
      "src": "./assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Files",
      "url": "./?app=files",
      "description": "Open the local file manager",
      "icons": [
        {
          "src": "./assets/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Task Manager",
      "url": "./?app=taskmanager",
      "description": "Inspect the web desktop session",
      "icons": [
        {
          "src": "./assets/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
